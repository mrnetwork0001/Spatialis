{
  "name": "spatialis",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json && node Tools/patch-build.js --mode=cjs --dir=.build",
    "build:web": "tsc -p tsconfig.web.json && node Tools/patch-build.js --mode=esm --dir=Simulator/build",
    "test": "npm run build:test && node Tests/run.js",
    "sim": "npm run build:web && python3 Tools/serve.py 8777",
    "clean": "rm -rf .build Simulator/build"
  },
  "dependencies": {
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.16"
  },
  "description": "Voice & gesture 3D spatial interior design tool for Snap Spectacles (Lens Studio 5.22+).",
  "license": "Apache-2.0"
}
