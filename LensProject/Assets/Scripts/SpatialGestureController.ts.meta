  InputLines:
    - '// @input AssignableType_1 anchorEngine {"hint":"Surface Anchor Engine used to re-seat a piece when it is released."}'
    - '// @input float pinchDownDistance = 3 {"hint":"Thumb-to-index distance that closes a pinch, cm.", "widget":"slider", "min":1, "max":6, "step":0.1}'
